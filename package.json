{
  "name": "examforge",
  "private": true,
  "version": "0.1.0",
  "description": "Plateforme d'entraînement aux certifications IT — premier produit : simulateur CCNA 200-301",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "dev:api": "pnpm --filter @examforge/api dev",
    "dev:web": "pnpm --filter @examforge/web dev",
    "db:migrate": "pnpm --filter @examforge/api db:migrate",
    "db:seed": "pnpm --filter @examforge/api db:seed"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.18.0"
  }
}
