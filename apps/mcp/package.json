{
  "name": "@examforge/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur MCP exam-forge-mcp : outils de génération et d'analyse, branchés sur l'API (jamais directement sur la base).",
  "type": "module",
  "bin": { "exam-forge-mcp": "./dist/server.js" },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@examforge/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
