{
  "name": "@examforge/content",
  "version": "0.1.0",
  "private": true,
  "description": "Contenu des certifications (configuration + banque de questions), au format données.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "data"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "batch:context": "node scripts/batch-context.mjs",
    "batch:check": "node scripts/check-batch.mjs",
    "near-duplicates": "node scripts/near-duplicates.mjs",
    "batch:merge": "node scripts/merge-batch.mjs",
    "series:build": "node scripts/build-series.mjs",
    "series:check": "node scripts/build-series.mjs --check",
    "sample": "node scripts/sample-batch.mjs"
  },
  "dependencies": {
    "@examforge/core": "workspace:*"
  }
}
