          { "type": "line", "sectionPattern": "^interface FastEthernet0/(1[1-9]|20)$", "sections": "all", "line": "switchport access vlan 20" }
        ]
      }
    },
    {
      "id": "ports-parking",
      "description": "Le VLAN 999 « PARKING » existe ; Fa0/21 à Fa0/24 sont des ports d'accès statiques de ce VLAN, désactivés.",
      "check": {
        "type": "all",
        "checks": [
          { "type": "line", "section": "vlan 999", "line": "name PARKING" },
          { "type": "line", "sectionPattern": "^interface FastEthernet0/2[1-4]$", "sections": "all", "line": "switchport mode access" },
          { "type": "line", "sectionPattern": "^interface FastEthernet0/2[1-4]$", "sections": "all", "line": "switchport access vlan 999" },
          { "type": "line", "sectionPattern": "^interface FastEthernet0/2[1-4]$", "sections": "all", "line": "shutdown" }
        ]
      }
    },
    {
      "id": "lien-montant",
      "description": "Gi0/1, le lien montant vers le cœur, est un trunk statique.",
      "check": { "type": "line", "section": "interface GigabitEthernet0/1", "line": "switchport mode trunk" }
    }
  ],
  "hints": [],
  "challenge": {
    "targetMinutes": 4,
    "timeLimitMinutes": 8,
    "mode": "build",
    "faults": []
  },
  "solution": [
    {
      "device": "S1",
      "commands": [
        "enable",
        "configure terminal",
        "vlan 10",
        "name VENTES",
        "vlan 20",
        "name COMPTA",
        "vlan 999",
        "name PARKING",
        "exit",
        "interface range FastEthernet0/1 - 10",
        "switchport mode access",
        "switchport access vlan 10",
        "interface range FastEthernet0/11 - 20",
        "switchport mode access",
        "switchport access vlan 20",
        "interface range FastEthernet0/21 - 24",
        "switchport mode access",
        "switchport access vlan 999",
        "shutdown",
        "interface GigabitEthernet0/1",
        "switchport mode trunk",
        "end"
      ]
    }
  ],
