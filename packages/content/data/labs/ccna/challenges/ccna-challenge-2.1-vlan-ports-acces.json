  "title": "Contre la montre : VLAN et ports d'accès d'un nouveau commutateur",
  "statement": "Un commutateur S1 (Catalyst 2960) tout neuf doit être prêt avant l'arrivée des équipes VENTES et COMPTA. Configurez-le le plus vite possible :\n1. Créez les VLAN 10 « VENTES », 20 « COMPTA » et 999 « PARKING ».\n2. Fa0/1 à Fa0/10 : ports d'accès statiques du VLAN 10.\n3. Fa0/11 à Fa0/20 : ports d'accès statiques du VLAN 20.\n4. Fa0/21 à Fa0/24, inutilisés : ports d'accès statiques rangés dans le VLAN 999 et désactivés.\n5. Gi0/1, le lien montant vers le cœur : trunk statique.\n\nLe chronomètre démarre avec la session.",
  "topology": "                 cœur de réseau\n                       |\n                     Gi0/1 (trunk)\n  +----------------------------------------------+\n  |                   S1 (2960)                  |\n  +----------------------------------------------+\n   Fa0/1-10         Fa0/11-20        Fa0/21-24\n   VLAN 10 VENTES   VLAN 20 COMPTA   VLAN 999 PARKING (désactivés)",
  "profile": "cisco-ios",
  "devices": [
    {
      "id": "S1",
      "type": "switch",
      "interfaces": ["FastEthernet0/1-24", "GigabitEthernet0/1-2"],
      "startupConfig": "hostname S1\nno ip domain-lookup"
    }
  ],
  "objectives": [
    {
      "id": "vlans-metier",
      "description": "Les VLAN 10 « VENTES » et 20 « COMPTA » existent avec leur nom.",
      "check": {
        "type": "all",
        "checks": [
          { "type": "line", "section": "vlan 10", "line": "name VENTES" },
          { "type": "line", "section": "vlan 20", "line": "name COMPTA" }
        ]
      }
    },
    {
      "id": "ports-ventes",
      "description": "Fa0/1 à Fa0/10 sont des ports d'accès statiques du VLAN 10.",
      "check": {
