{
  "slug": "ccna-lab-5.3-acces-console-vty",
  "certification": "ccna",
  "domain": "5.0",
  "subtopic": "5.3",
  "difficulty": "easy",
  "title": "Verrouiller l'accès console, VTY et privilégié d'un commutateur",
  "statement": "Le commutateur d'accès S1 sort d'un audit : le mode privilégié est protégé par un enable password en clair, la console ne demande rien, et les lignes VTY partagent le mot de passe de ligne « cisco ». Toutes les lignes portent exec-timeout 0 0 : une session oubliée reste ouverte indéfiniment.\n\nConfigurez S1 :\n1. Protégez le mode privilégié par le secret haché En4ble-Acc3s! et supprimez l'ancien enable password.\n2. Sur la console 0, exigez le mot de passe de ligne C0nsole-S1 et fermez la session après 5 minutes d'inactivité.\n3. Créez le compte local admin, de niveau de privilège 15, dont le mot de passe est stocké sous forme de secret haché (Adm1n-S1!).\n4. Sur toutes les lignes VTY (0 à 15), authentifiez les sessions par les comptes locaux et fermez-les après 15 minutes d'inactivité.\n5. Chiffrez les mots de passe qui restent stockés en clair dans la configuration.",
  "topology": "  Poste d'administration ---- Fa0/1 [S1] Gi0/1 ---- (cœur de réseau)\n                                     |\n                              Console (câble RJ-45)\n\n  Configuration actuelle de S1 :\n    enable password cisco\n    line con 0 : exec-timeout 0 0, aucune authentification\n    line vty 0 4 et 5 15 : password cisco + login, exec-timeout 0 0",
  "profile": "cisco-ios",
  "devices": [
    {
      "id": "S1",
      "type": "switch",
      "interfaces": ["FastEthernet0/1-24", "GigabitEthernet0/1-2"],
      "startupConfig": "hostname S1\nno ip domain-lookup\nenable password cisco\nline con 0\n exec-timeout 0 0\nline vty 0 4\n exec-timeout 0 0\n password cisco\n login\nline vty 5 15\n exec-timeout 0 0\n password cisco\n login"
    }
  ],
  "objectives": [
    {
      "id": "enable-secret",
      "description": "Le mode privilégié est protégé par le secret haché En4ble-Acc3s!, et aucun enable password ne subsiste.",
      "check": {
        "type": "all",
        "checks": [
          {"type": "regex", "pattern": "^enable secret (0 )?En4ble-Acc3s!$", "caseSensitive": true},
          {"type": "regex", "pattern": "^enable password ", "absent": true}
        ]
      }
    },
    {
      "id": "console-login",
      "description": "La console 0 demande le mot de passe de ligne C0nsole-S1.",
      "check": {
        "type": "all",
        "checks": [
          {"type": "regex", "sectionPattern": "^line con(sole)? 0$", "pattern": "^password (0 )?C0nsole-S1$", "caseSensitive": true},
          {"type": "line", "sectionPattern": "^line con(sole)? 0$", "line": "login"}
        ]
      }
    },
    {
      "id": "console-timeout",
      "description": "Une session console inactive est fermée après 5 minutes.",
      "check": {"type": "line", "sectionPattern": "^line con(sole)? 0$", "line": ["exec-timeout 5", "exec-timeout 5 0", "exec-timeout 0 300"]}
    },
    {
      "id": "local-user",
      "description": "Le compte local admin existe, de niveau 15, avec le secret haché Adm1n-S1!.",
      "check": {
        "type": "all",
        "checks": [
          {"type": "regex", "pattern": "^username admin privilege 15 secret (0 )?Adm1n-S1!$", "caseSensitive": true},
          {"type": "regex", "pattern": "^username admin .*password ", "absent": true}
        ]
      }
    },
