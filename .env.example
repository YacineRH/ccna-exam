# Copier en .env sur le serveur (jamais commité) puis remplir.
# Générer les secrets avec : openssl rand -base64 48

# Base PostgreSQL du projet (distincte de celle d'Hydre)
POSTGRES_PASSWORD=

# Signature des sessions (32 caractères minimum)
JWT_SECRET=

# Jeton du serveur MCP (32 caractères minimum). Laisser vide pour désactiver l'accès MCP.
SERVICE_TOKEN=

# Le tout premier compte est toujours accepté et devient admin. Mettre true pour ouvrir à d'autres.
ALLOW_REGISTRATION=false

# Port HTTP du service web. Sur le VPS il reste sur 127.0.0.1 (le Caddy d'Hydre passe par le réseau « edge »).
HTTP_PORT=8080
# Serveur sur le réseau local, sans HTTPS devant : IP LAN du serveur (ex. 192.168.1.125) et cookie non « Secure ».
# Ne jamais utiliser COOKIE_SECURE=false sur un serveur exposé à Internet.
# BIND_IP=192.168.1.125
# COOKIE_SECURE=false

LOG_LEVEL=info

# --- Développement local uniquement ---
# DATABASE_URL=postgres://examforge:examforge@localhost:5432/examforge
# TEST_DATABASE_URL=postgres://examforge:examforge@localhost:5432/examforge_test
