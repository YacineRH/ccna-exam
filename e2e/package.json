{
  "name": "@examforge/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tests de bout en bout dans Chromium : API sur la base de test + front buildé.",
  "scripts": {
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "e2e:sweep": "playwright test --config playwright.sweep.config.ts",
    "e2e:browsers": "playwright test --config playwright.browsers.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@examforge/content": "workspace:*",
    "@examforge/core": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
